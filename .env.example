# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - used only by scripts/bootstrap-admin.mjs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_BOOTSTRAP_EMAIL=admin@mediguide.ai
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISABLED=false
# AI assistant (optional; without it the UI shows a flagged offline demo reply)
AI_PROVIDER_API_KEY=
AI_MODEL=claude-haiku-5-5
# Optional
NEXT_PUBLIC_EMERGENCY_NUMBER=112
NEXT_PUBLIC_API_URL=
